[Unit]
Description=pplx-proxy - Perplexity Pro reverse proxy
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
# Adjust the user, paths and port for your installation.
User=YOUR_USER
WorkingDirectory=/opt/pplx-proxy
EnvironmentFile=/opt/pplx-proxy/.env
ExecStart=/opt/pplx-proxy/venv/bin/uvicorn server:app --host 0.0.0.0 --port 8892 --log-level info
Restart=always
RestartSec=3
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
